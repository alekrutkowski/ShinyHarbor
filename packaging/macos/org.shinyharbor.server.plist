<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>org.shinyharbor.server</string>
<key>ProgramArguments</key><array><string>/usr/local/bin/shinyharbor</string><string>serve</string><string>--config</string><string>/etc/shinyharbor/harbor.toml</string></array>
<key>UserName</key><string>_shinyharbor</string>
<key>GroupName</key><string>_shinyharbor</string>
<key>WorkingDirectory</key><string>/Library/Application Support/ShinyHarbor</string>
<key>RunAtLoad</key><true/>
<key>KeepAlive</key><true/>
<key>ThrottleInterval</key><integer>5</integer>
<key>Umask</key><integer>63</integer>
<key>ExitTimeOut</key><integer>75</integer>
<key>StandardOutPath</key><string>/Library/Application Support/ShinyHarbor/state/service.log</string>
<key>StandardErrorPath</key><string>/Library/Application Support/ShinyHarbor/state/service.log</string>
</dict></plist>
